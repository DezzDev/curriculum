---
import { basics } from "@cv";
import Portfolio from "@/icons/Portfolio.astro";
const { portfolio, profiles, name } = basics;
const github = profiles.find(({ network }) => network === "Github");
const githubUrl = github?.url;
---

<section class="no-print">
	<h1>Proyectos</h1>

	<p>
		Puedes consultar mis proyectos personales, demostraciones y código fuente en
		mi
		<a
			href={portfolio}
			title={`Visitar el portfolio de ${name}`}
			target="_blank"
			rel="noopener noreferrer"
		>
			portfolio
		</a>
		y perfil de
		<a
			href={githubUrl}
			title={`Visitar el perfil de ${name} en Github`}
			target="_blank"
			rel="noopener noreferrer"
		>
			Github
		</a>
	</p>
</section>

<style>
	a {
		font-weight: 600;
		color: var(--h2-color);
		text-decoration: underline;
	}
</style>
