---
import {skills} from "@cv"
import HTML from "@/icons/Html.astro"
import CSS from "@/icons/Css.astro"
import JavaScript from "@/icons/JavaScript.astro"
import TypeScript from "@/icons/TypeScript.astro"
import Java from "@/icons/Java.astro"
import PHP from "@/icons/Php.astro"
import MySQL from "@/icons/Mysql.astro"
import React from "@/icons/React.astro"
import Angular from "@/icons/Angular.astro"
import Astroo from "@/icons/Astro.astro"
import MongoDb from "@/icons/Mongodb.astro"
import SpringBoot from "@/icons/SpringBoot.astro"


const SKILLS_ICONS: Record<string, any> = {
	HTML,
	CSS,
	JavaScript,
	TypeScript,
	Java,
	SpringBoot,
	PHP,
	MySQL,
	React,
	Angular,
	Astroo,
	MongoDb,
}
---

<section>
	<h1>Skills</h1>
	
	<h3>Lenguajes</h3>
	<ul>
		{
			skills.languages.map((name) =>{
				const IconSkill = SKILLS_ICONS[name];				
				return(
					<li>						
						{IconSkill && <IconSkill />}
						<span>{name}</span>
					</li>
				)
			})
		}
	</ul>

	<h3>Frontend</h3>
	<ul>
		{
			skills.frontend.map((name) =>{
				const IconSkill = SKILLS_ICONS[name];				
				return(
					<li>						
						{IconSkill && <IconSkill />}
						<span>{name}</span>
					</li>
				)
			})
		}
	</ul>

	<h3>Backend</h3>
	<ul>
		{
			skills.backend.map((name) =>{
				const IconSkill = SKILLS_ICONS[name];				
				return(
					<li>						
						{IconSkill && <IconSkill />}
						<span>{name}</span>
					</li>
				)
			})
		}
	</ul>

	<h3>Bases de datos</h3>
	<ul>
		{
			skills.data_bases.map((name) =>{
				const IconSkill = SKILLS_ICONS[name];				
				return(
					<li>						
						{IconSkill && <IconSkill />}
						<span>{name}</span>
					</li>
				)
			})
		}
	</ul>
	
	<h3>Herramientas</h3>
	<ul>
		{
			skills.tools.map((name) =>{
				const IconSkill = SKILLS_ICONS[name];				
				return(
					<li>						
						{IconSkill && <IconSkill />}
						<span>{name}</span>
					</li>
				)
			})
		}
	</ul>
</section>

<style>
	ul{
		display: flex;
		flex-flow: row wrap;
		gap: 1rem;
		margin-bottom: 1rem;
	}

	li {
		background-color: #eee;
		color: #000;
		padding: 0.2rem 0.6rem;
		border-radius: 5px;
		font-weight: 500;
		display: flex;
		flex-direction: row;
		gap: .5rem;

	}

</style>