---
import {skills} from "@cv"
import HTML from "@/icons/Html.astro"
import CSS from "@/icons/Css.astro"
import JavaScript from "@/icons/JavaScript.astro"
import TypeScript from "@/icons/TypeScript.astro"
import Java from "@/icons/Java.astro"
import MySQL from "@/icons/Mysql.astro"
import React from "@/icons/React.astro"
import Angular from "@/icons/Angular.astro"
import Nodejs from "@/icons/Nodejs.astro"
import SpringBoot from "@/icons/SpringBoot.astro"
import SQL from "@/icons/Sql.astro"
import Tailwind from "@/icons/Tailwind.astro"
import Express from "@/icons/Express.astro"
import Sqlite from "@/icons/Sqlite.astro"
import Git from "@/icons/Git.astro"
import Github from "@/icons/Github.astro"
import Docker from "@/icons/Docker.astro"


const SKILLS_ICONS: Record<string, any> = {
	"HTML": {
    icon: HTML,
    text: "HTML"
  },
	"CSS": {
    icon: CSS,
    text: "CSS"
  },
	"JavaScript": {
    icon: JavaScript,
    text: "JavaScript"
  },
	"TypeScript": {
    icon: TypeScript,
    text: "TypeScript"
  },
	"Java": {
    icon: Java,
    text: "Java"
  },
	"SpringBoot": {
    icon: SpringBoot,
    text: "Spring Boot"
  },
	"MySQL": {
    icon: MySQL,
    text: "MySQL"
  },
	"React": {
    icon: React,
    text: "React"
  },
	"Angular": {
    icon: Angular,
    text: "Angular"
  },
	"Nodejs": {
    icon: Nodejs,
    text: "Node.js"
  },
	"SQL": {
    icon: SQL,
    text: "SQL"
  },
	"Tailwind": {
    icon: Tailwind,
    text: "Tailwind CSS"
  },
  "Express": {
    icon: Express,
    text: "Express"
  },
  "Sqlite": {
    icon: Sqlite,
    text: "SQLite"
  },
  "Git": {
    icon: Git,
    text: "Git"
  },
  "Github": {
    icon: Github,
    text: "GitHub"
  },
  "Docker": {
    icon: Docker,
    text: "Docker"
  }

}

---

<section>
	<h1>Skills</h1>
	
	<h3>Lenguajes</h3>
	<ul>
		{
			skills.languages.map((name) =>{
				const IconSkill = SKILLS_ICONS[name];				
				return(
					<li>						
						{IconSkill && <IconSkill.icon />}
						<span>{IconSkill.text}</span>
					</li>
				)
			})
		}
	</ul>

	<h3>Frontend</h3>
	<ul>
		{
			skills.frontend.map((name) =>{
				const IconSkill = SKILLS_ICONS[name];				
				return(
					<li>						
						{IconSkill && <IconSkill.icon />}
						<span>{IconSkill.text}</span>
					</li>
				)
			})
		}
	</ul>

	<h3>Backend</h3>
	<ul>
		{
			skills.backend.map((name) =>{
				const IconSkill = SKILLS_ICONS[name];				
				return(
					<li>						
						{IconSkill && <IconSkill.icon />}
						{IconSkill && <span>{IconSkill.text}</span>}
					</li>
				)
			})
		}
	</ul>

	<h3>Bases de datos</h3>
	<ul>
		{
			skills.data_bases.map((name) =>{
				const IconSkill = SKILLS_ICONS[name];				
				return(
					<li>						
						{IconSkill && <IconSkill.icon />}
						{ <span>{IconSkill.text}</span> }
					</li>
				)
			})
		}
	</ul>
	
	<h3>Herramientas</h3>
	<ul>
		{
			skills.tools.map((name) =>{
				const IconSkill = SKILLS_ICONS[name];				
				return(
					<li>						
						{IconSkill && <IconSkill.icon width="16px" height="16px" />}
						{ <span>{IconSkill.text}</span> }
					</li>
				)
			})
		}
	</ul>
</section>

<style>
	ul{
		display: flex;
		flex-flow: row wrap;
		gap:0.5rem;
		margin-bottom: 1rem;
	}

	li {
		background-color: #eee;
		color: #000;
		padding: 0.2rem 0.6rem;
		border-radius: 5px;
		font-weight: 500;
		display: flex;
		flex-direction: row;
		gap: .5rem;

	}

</style>